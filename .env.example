# Public Vite configuration (safe to embed in the browser bundle)
VITE_COMPUTE_INTEREST_ENDPOINT=https://YOUR_PROJECT.supabase.co/functions/v1/compute-interest
VITE_CROWDFUNDING_PROVIDER_ENABLED=false
VITE_CROWDFUNDING_PROVIDER_NAME=
VITE_CROWDFUNDING_PROVIDER_PROJECT_URL=
VITE_CROWDFUNDING_PROVIDER_CANDIDATE_ID=

# Supabase Edge Function secrets (never prefix these with VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
COMPUTE_INTEREST_ALLOWED_ORIGINS=https://www.albedo-industries.com,https://albedo-industries.com
COMPUTE_INTEREST_RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Optional Resend notification settings
COMPUTE_INTEREST_NOTIFICATION_EMAIL=compute-ops@example.com
RESEND_API_KEY=re_replace-with-resend-key
COMPUTE_INTEREST_FROM_EMAIL=Albedo Compute <compute@example.com>
